<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <TextView android:id="@+id/eval_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Debug Eval Bridge" />
        <EditText android:id="@+id/eval_command" android:layout_width="match_parent" android:layout_height="180dp" android:gravity="top" android:hint="粘贴 EvalCommand JSON" android:inputType="textMultiLine" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/eval_connect" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="连接" />
            <Button android:id="@+id/eval_acquire" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="获取环境" />
            <Button android:id="@+id/eval_execute" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="执行" />
            <Button android:id="@+id/eval_release" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="释放环境" />
        </LinearLayout>
        <TextView android:id="@+id/eval_result" android:layout_width="match_parent" android:layout_height="wrap_content" android:textIsSelectable="true" />
    </LinearLayout>
</ScrollView>
